// Exhaustive scalar datatype promotion matrix.
//
// For every ordered pair of scalar numeric types, verify that a binary
// arithmetic operation promotes both operands to the more-precise type
// (the one with the higher Kind rank) in both value and result type. This
// exercises the type-switch in each promoting bytecode (add/subtract/
// multiply/divide) for completeness and correctness.
//
// Promotion order (least to most precise):
//   byte < int8 < int16 < uint16 < int32 < uint32 < int < uint <
//   int64 < uint64 < float32 < float64 < complex64 < complex128
//
// Implicit numeric widening is a relaxed/dynamic-mode feature. Go -- and
// therefore Ego's strict mode -- rejects arithmetic between two differently
// typed non-constant operands (e.g. "byte(6) + int8(3)" is a compile error in
// Go: "mismatched types"). Each block below pins itself to relaxed typing with
// @type so the matrix behaves identically no matter what --types the suite is
// run with; it is not a strict-mode test.

@test "datamodel: scalar promotion, addition" {
	@type relaxed
	@assert byte(6) + byte(3) == byte(9)
	@assert typeof(byte(6) + byte(3)) == byte
	@assert byte(6) + int8(3) == int8(9)
	@assert typeof(byte(6) + int8(3)) == int8
	@assert byte(6) + int16(3) == int16(9)
	@assert typeof(byte(6) + int16(3)) == int16
	@assert byte(6) + uint16(3) == uint16(9)
	@assert typeof(byte(6) + uint16(3)) == uint16
	@assert byte(6) + int32(3) == int32(9)
	@assert typeof(byte(6) + int32(3)) == int32
	@assert byte(6) + uint32(3) == uint32(9)
	@assert typeof(byte(6) + uint32(3)) == uint32
	@assert byte(6) + int(3) == int(9)
	@assert typeof(byte(6) + int(3)) == int
	@assert byte(6) + uint(3) == uint(9)
	@assert typeof(byte(6) + uint(3)) == uint
	@assert byte(6) + int64(3) == int64(9)
	@assert typeof(byte(6) + int64(3)) == int64
	@assert byte(6) + uint64(3) == uint64(9)
	@assert typeof(byte(6) + uint64(3)) == uint64
	@assert byte(6) + float32(3) == float32(9)
	@assert typeof(byte(6) + float32(3)) == float32
	@assert byte(6) + float64(3) == float64(9)
	@assert typeof(byte(6) + float64(3)) == float64
	@assert byte(6) + complex64(3) == complex64(9)
	@assert typeof(byte(6) + complex64(3)) == complex64
	@assert byte(6) + complex128(3) == complex128(9)
	@assert typeof(byte(6) + complex128(3)) == complex128

	@assert int8(6) + byte(3) == int8(9)
	@assert typeof(int8(6) + byte(3)) == int8
	@assert int8(6) + int8(3) == int8(9)
	@assert typeof(int8(6) + int8(3)) == int8
	@assert int8(6) + int16(3) == int16(9)
	@assert typeof(int8(6) + int16(3)) == int16
	@assert int8(6) + uint16(3) == uint16(9)
	@assert typeof(int8(6) + uint16(3)) == uint16
	@assert int8(6) + int32(3) == int32(9)
	@assert typeof(int8(6) + int32(3)) == int32
	@assert int8(6) + uint32(3) == uint32(9)
	@assert typeof(int8(6) + uint32(3)) == uint32
	@assert int8(6) + int(3) == int(9)
	@assert typeof(int8(6) + int(3)) == int
	@assert int8(6) + uint(3) == uint(9)
	@assert typeof(int8(6) + uint(3)) == uint
	@assert int8(6) + int64(3) == int64(9)
	@assert typeof(int8(6) + int64(3)) == int64
	@assert int8(6) + uint64(3) == uint64(9)
	@assert typeof(int8(6) + uint64(3)) == uint64
	@assert int8(6) + float32(3) == float32(9)
	@assert typeof(int8(6) + float32(3)) == float32
	@assert int8(6) + float64(3) == float64(9)
	@assert typeof(int8(6) + float64(3)) == float64
	@assert int8(6) + complex64(3) == complex64(9)
	@assert typeof(int8(6) + complex64(3)) == complex64
	@assert int8(6) + complex128(3) == complex128(9)
	@assert typeof(int8(6) + complex128(3)) == complex128

	@assert int16(6) + byte(3) == int16(9)
	@assert typeof(int16(6) + byte(3)) == int16
	@assert int16(6) + int8(3) == int16(9)
	@assert typeof(int16(6) + int8(3)) == int16
	@assert int16(6) + int16(3) == int16(9)
	@assert typeof(int16(6) + int16(3)) == int16
	@assert int16(6) + uint16(3) == uint16(9)
	@assert typeof(int16(6) + uint16(3)) == uint16
	@assert int16(6) + int32(3) == int32(9)
	@assert typeof(int16(6) + int32(3)) == int32
	@assert int16(6) + uint32(3) == uint32(9)
	@assert typeof(int16(6) + uint32(3)) == uint32
	@assert int16(6) + int(3) == int(9)
	@assert typeof(int16(6) + int(3)) == int
	@assert int16(6) + uint(3) == uint(9)
	@assert typeof(int16(6) + uint(3)) == uint
	@assert int16(6) + int64(3) == int64(9)
	@assert typeof(int16(6) + int64(3)) == int64
	@assert int16(6) + uint64(3) == uint64(9)
	@assert typeof(int16(6) + uint64(3)) == uint64
	@assert int16(6) + float32(3) == float32(9)
	@assert typeof(int16(6) + float32(3)) == float32
	@assert int16(6) + float64(3) == float64(9)
	@assert typeof(int16(6) + float64(3)) == float64
	@assert int16(6) + complex64(3) == complex64(9)
	@assert typeof(int16(6) + complex64(3)) == complex64
	@assert int16(6) + complex128(3) == complex128(9)
	@assert typeof(int16(6) + complex128(3)) == complex128

	@assert uint16(6) + byte(3) == uint16(9)
	@assert typeof(uint16(6) + byte(3)) == uint16
	@assert uint16(6) + int8(3) == uint16(9)
	@assert typeof(uint16(6) + int8(3)) == uint16
	@assert uint16(6) + int16(3) == uint16(9)
	@assert typeof(uint16(6) + int16(3)) == uint16
	@assert uint16(6) + uint16(3) == uint16(9)
	@assert typeof(uint16(6) + uint16(3)) == uint16
	@assert uint16(6) + int32(3) == int32(9)
	@assert typeof(uint16(6) + int32(3)) == int32
	@assert uint16(6) + uint32(3) == uint32(9)
	@assert typeof(uint16(6) + uint32(3)) == uint32
	@assert uint16(6) + int(3) == int(9)
	@assert typeof(uint16(6) + int(3)) == int
	@assert uint16(6) + uint(3) == uint(9)
	@assert typeof(uint16(6) + uint(3)) == uint
	@assert uint16(6) + int64(3) == int64(9)
	@assert typeof(uint16(6) + int64(3)) == int64
	@assert uint16(6) + uint64(3) == uint64(9)
	@assert typeof(uint16(6) + uint64(3)) == uint64
	@assert uint16(6) + float32(3) == float32(9)
	@assert typeof(uint16(6) + float32(3)) == float32
	@assert uint16(6) + float64(3) == float64(9)
	@assert typeof(uint16(6) + float64(3)) == float64
	@assert uint16(6) + complex64(3) == complex64(9)
	@assert typeof(uint16(6) + complex64(3)) == complex64
	@assert uint16(6) + complex128(3) == complex128(9)
	@assert typeof(uint16(6) + complex128(3)) == complex128

	@assert int32(6) + byte(3) == int32(9)
	@assert typeof(int32(6) + byte(3)) == int32
	@assert int32(6) + int8(3) == int32(9)
	@assert typeof(int32(6) + int8(3)) == int32
	@assert int32(6) + int16(3) == int32(9)
	@assert typeof(int32(6) + int16(3)) == int32
	@assert int32(6) + uint16(3) == int32(9)
	@assert typeof(int32(6) + uint16(3)) == int32
	@assert int32(6) + int32(3) == int32(9)
	@assert typeof(int32(6) + int32(3)) == int32
	@assert int32(6) + uint32(3) == uint32(9)
	@assert typeof(int32(6) + uint32(3)) == uint32
	@assert int32(6) + int(3) == int(9)
	@assert typeof(int32(6) + int(3)) == int
	@assert int32(6) + uint(3) == uint(9)
	@assert typeof(int32(6) + uint(3)) == uint
	@assert int32(6) + int64(3) == int64(9)
	@assert typeof(int32(6) + int64(3)) == int64
	@assert int32(6) + uint64(3) == uint64(9)
	@assert typeof(int32(6) + uint64(3)) == uint64
	@assert int32(6) + float32(3) == float32(9)
	@assert typeof(int32(6) + float32(3)) == float32
	@assert int32(6) + float64(3) == float64(9)
	@assert typeof(int32(6) + float64(3)) == float64
	@assert int32(6) + complex64(3) == complex64(9)
	@assert typeof(int32(6) + complex64(3)) == complex64
	@assert int32(6) + complex128(3) == complex128(9)
	@assert typeof(int32(6) + complex128(3)) == complex128

	@assert uint32(6) + byte(3) == uint32(9)
	@assert typeof(uint32(6) + byte(3)) == uint32
	@assert uint32(6) + int8(3) == uint32(9)
	@assert typeof(uint32(6) + int8(3)) == uint32
	@assert uint32(6) + int16(3) == uint32(9)
	@assert typeof(uint32(6) + int16(3)) == uint32
	@assert uint32(6) + uint16(3) == uint32(9)
	@assert typeof(uint32(6) + uint16(3)) == uint32
	@assert uint32(6) + int32(3) == uint32(9)
	@assert typeof(uint32(6) + int32(3)) == uint32
	@assert uint32(6) + uint32(3) == uint32(9)
	@assert typeof(uint32(6) + uint32(3)) == uint32
	@assert uint32(6) + int(3) == int(9)
	@assert typeof(uint32(6) + int(3)) == int
	@assert uint32(6) + uint(3) == uint(9)
	@assert typeof(uint32(6) + uint(3)) == uint
	@assert uint32(6) + int64(3) == int64(9)
	@assert typeof(uint32(6) + int64(3)) == int64
	@assert uint32(6) + uint64(3) == uint64(9)
	@assert typeof(uint32(6) + uint64(3)) == uint64
	@assert uint32(6) + float32(3) == float32(9)
	@assert typeof(uint32(6) + float32(3)) == float32
	@assert uint32(6) + float64(3) == float64(9)
	@assert typeof(uint32(6) + float64(3)) == float64
	@assert uint32(6) + complex64(3) == complex64(9)
	@assert typeof(uint32(6) + complex64(3)) == complex64
	@assert uint32(6) + complex128(3) == complex128(9)
	@assert typeof(uint32(6) + complex128(3)) == complex128

	@assert int(6) + byte(3) == int(9)
	@assert typeof(int(6) + byte(3)) == int
	@assert int(6) + int8(3) == int(9)
	@assert typeof(int(6) + int8(3)) == int
	@assert int(6) + int16(3) == int(9)
	@assert typeof(int(6) + int16(3)) == int
	@assert int(6) + uint16(3) == int(9)
	@assert typeof(int(6) + uint16(3)) == int
	@assert int(6) + int32(3) == int(9)
	@assert typeof(int(6) + int32(3)) == int
	@assert int(6) + uint32(3) == int(9)
	@assert typeof(int(6) + uint32(3)) == int
	@assert int(6) + int(3) == int(9)
	@assert typeof(int(6) + int(3)) == int
	@assert int(6) + uint(3) == uint(9)
	@assert typeof(int(6) + uint(3)) == uint
	@assert int(6) + int64(3) == int64(9)
	@assert typeof(int(6) + int64(3)) == int64
	@assert int(6) + uint64(3) == uint64(9)
	@assert typeof(int(6) + uint64(3)) == uint64
	@assert int(6) + float32(3) == float32(9)
	@assert typeof(int(6) + float32(3)) == float32
	@assert int(6) + float64(3) == float64(9)
	@assert typeof(int(6) + float64(3)) == float64
	@assert int(6) + complex64(3) == complex64(9)
	@assert typeof(int(6) + complex64(3)) == complex64
	@assert int(6) + complex128(3) == complex128(9)
	@assert typeof(int(6) + complex128(3)) == complex128

	@assert uint(6) + byte(3) == uint(9)
	@assert typeof(uint(6) + byte(3)) == uint
	@assert uint(6) + int8(3) == uint(9)
	@assert typeof(uint(6) + int8(3)) == uint
	@assert uint(6) + int16(3) == uint(9)
	@assert typeof(uint(6) + int16(3)) == uint
	@assert uint(6) + uint16(3) == uint(9)
	@assert typeof(uint(6) + uint16(3)) == uint
	@assert uint(6) + int32(3) == uint(9)
	@assert typeof(uint(6) + int32(3)) == uint
	@assert uint(6) + uint32(3) == uint(9)
	@assert typeof(uint(6) + uint32(3)) == uint
	@assert uint(6) + int(3) == uint(9)
	@assert typeof(uint(6) + int(3)) == uint
	@assert uint(6) + uint(3) == uint(9)
	@assert typeof(uint(6) + uint(3)) == uint
	@assert uint(6) + int64(3) == int64(9)
	@assert typeof(uint(6) + int64(3)) == int64
	@assert uint(6) + uint64(3) == uint64(9)
	@assert typeof(uint(6) + uint64(3)) == uint64
	@assert uint(6) + float32(3) == float32(9)
	@assert typeof(uint(6) + float32(3)) == float32
	@assert uint(6) + float64(3) == float64(9)
	@assert typeof(uint(6) + float64(3)) == float64
	@assert uint(6) + complex64(3) == complex64(9)
	@assert typeof(uint(6) + complex64(3)) == complex64
	@assert uint(6) + complex128(3) == complex128(9)
	@assert typeof(uint(6) + complex128(3)) == complex128

	@assert int64(6) + byte(3) == int64(9)
	@assert typeof(int64(6) + byte(3)) == int64
	@assert int64(6) + int8(3) == int64(9)
	@assert typeof(int64(6) + int8(3)) == int64
	@assert int64(6) + int16(3) == int64(9)
	@assert typeof(int64(6) + int16(3)) == int64
	@assert int64(6) + uint16(3) == int64(9)
	@assert typeof(int64(6) + uint16(3)) == int64
	@assert int64(6) + int32(3) == int64(9)
	@assert typeof(int64(6) + int32(3)) == int64
	@assert int64(6) + uint32(3) == int64(9)
	@assert typeof(int64(6) + uint32(3)) == int64
	@assert int64(6) + int(3) == int64(9)
	@assert typeof(int64(6) + int(3)) == int64
	@assert int64(6) + uint(3) == int64(9)
	@assert typeof(int64(6) + uint(3)) == int64
	@assert int64(6) + int64(3) == int64(9)
	@assert typeof(int64(6) + int64(3)) == int64
	@assert int64(6) + uint64(3) == uint64(9)
	@assert typeof(int64(6) + uint64(3)) == uint64
	@assert int64(6) + float32(3) == float32(9)
	@assert typeof(int64(6) + float32(3)) == float32
	@assert int64(6) + float64(3) == float64(9)
	@assert typeof(int64(6) + float64(3)) == float64
	@assert int64(6) + complex64(3) == complex64(9)
	@assert typeof(int64(6) + complex64(3)) == complex64
	@assert int64(6) + complex128(3) == complex128(9)
	@assert typeof(int64(6) + complex128(3)) == complex128

	@assert uint64(6) + byte(3) == uint64(9)
	@assert typeof(uint64(6) + byte(3)) == uint64
	@assert uint64(6) + int8(3) == uint64(9)
	@assert typeof(uint64(6) + int8(3)) == uint64
	@assert uint64(6) + int16(3) == uint64(9)
	@assert typeof(uint64(6) + int16(3)) == uint64
	@assert uint64(6) + uint16(3) == uint64(9)
	@assert typeof(uint64(6) + uint16(3)) == uint64
	@assert uint64(6) + int32(3) == uint64(9)
	@assert typeof(uint64(6) + int32(3)) == uint64
	@assert uint64(6) + uint32(3) == uint64(9)
	@assert typeof(uint64(6) + uint32(3)) == uint64
	@assert uint64(6) + int(3) == uint64(9)
	@assert typeof(uint64(6) + int(3)) == uint64
	@assert uint64(6) + uint(3) == uint64(9)
	@assert typeof(uint64(6) + uint(3)) == uint64
	@assert uint64(6) + int64(3) == uint64(9)
	@assert typeof(uint64(6) + int64(3)) == uint64
	@assert uint64(6) + uint64(3) == uint64(9)
	@assert typeof(uint64(6) + uint64(3)) == uint64
	@assert uint64(6) + float32(3) == float32(9)
	@assert typeof(uint64(6) + float32(3)) == float32
	@assert uint64(6) + float64(3) == float64(9)
	@assert typeof(uint64(6) + float64(3)) == float64
	@assert uint64(6) + complex64(3) == complex64(9)
	@assert typeof(uint64(6) + complex64(3)) == complex64
	@assert uint64(6) + complex128(3) == complex128(9)
	@assert typeof(uint64(6) + complex128(3)) == complex128

	@assert float32(6) + byte(3) == float32(9)
	@assert typeof(float32(6) + byte(3)) == float32
	@assert float32(6) + int8(3) == float32(9)
	@assert typeof(float32(6) + int8(3)) == float32
	@assert float32(6) + int16(3) == float32(9)
	@assert typeof(float32(6) + int16(3)) == float32
	@assert float32(6) + uint16(3) == float32(9)
	@assert typeof(float32(6) + uint16(3)) == float32
	@assert float32(6) + int32(3) == float32(9)
	@assert typeof(float32(6) + int32(3)) == float32
	@assert float32(6) + uint32(3) == float32(9)
	@assert typeof(float32(6) + uint32(3)) == float32
	@assert float32(6) + int(3) == float32(9)
	@assert typeof(float32(6) + int(3)) == float32
	@assert float32(6) + uint(3) == float32(9)
	@assert typeof(float32(6) + uint(3)) == float32
	@assert float32(6) + int64(3) == float32(9)
	@assert typeof(float32(6) + int64(3)) == float32
	@assert float32(6) + uint64(3) == float32(9)
	@assert typeof(float32(6) + uint64(3)) == float32
	@assert float32(6) + float32(3) == float32(9)
	@assert typeof(float32(6) + float32(3)) == float32
	@assert float32(6) + float64(3) == float64(9)
	@assert typeof(float32(6) + float64(3)) == float64
	@assert float32(6) + complex64(3) == complex64(9)
	@assert typeof(float32(6) + complex64(3)) == complex64
	@assert float32(6) + complex128(3) == complex128(9)
	@assert typeof(float32(6) + complex128(3)) == complex128

	@assert float64(6) + byte(3) == float64(9)
	@assert typeof(float64(6) + byte(3)) == float64
	@assert float64(6) + int8(3) == float64(9)
	@assert typeof(float64(6) + int8(3)) == float64
	@assert float64(6) + int16(3) == float64(9)
	@assert typeof(float64(6) + int16(3)) == float64
	@assert float64(6) + uint16(3) == float64(9)
	@assert typeof(float64(6) + uint16(3)) == float64
	@assert float64(6) + int32(3) == float64(9)
	@assert typeof(float64(6) + int32(3)) == float64
	@assert float64(6) + uint32(3) == float64(9)
	@assert typeof(float64(6) + uint32(3)) == float64
	@assert float64(6) + int(3) == float64(9)
	@assert typeof(float64(6) + int(3)) == float64
	@assert float64(6) + uint(3) == float64(9)
	@assert typeof(float64(6) + uint(3)) == float64
	@assert float64(6) + int64(3) == float64(9)
	@assert typeof(float64(6) + int64(3)) == float64
	@assert float64(6) + uint64(3) == float64(9)
	@assert typeof(float64(6) + uint64(3)) == float64
	@assert float64(6) + float32(3) == float64(9)
	@assert typeof(float64(6) + float32(3)) == float64
	@assert float64(6) + float64(3) == float64(9)
	@assert typeof(float64(6) + float64(3)) == float64
	@assert float64(6) + complex64(3) == complex64(9)
	@assert typeof(float64(6) + complex64(3)) == complex64
	@assert float64(6) + complex128(3) == complex128(9)
	@assert typeof(float64(6) + complex128(3)) == complex128

	@assert complex64(6) + byte(3) == complex64(9)
	@assert typeof(complex64(6) + byte(3)) == complex64
	@assert complex64(6) + int8(3) == complex64(9)
	@assert typeof(complex64(6) + int8(3)) == complex64
	@assert complex64(6) + int16(3) == complex64(9)
	@assert typeof(complex64(6) + int16(3)) == complex64
	@assert complex64(6) + uint16(3) == complex64(9)
	@assert typeof(complex64(6) + uint16(3)) == complex64
	@assert complex64(6) + int32(3) == complex64(9)
	@assert typeof(complex64(6) + int32(3)) == complex64
	@assert complex64(6) + uint32(3) == complex64(9)
	@assert typeof(complex64(6) + uint32(3)) == complex64
	@assert complex64(6) + int(3) == complex64(9)
	@assert typeof(complex64(6) + int(3)) == complex64
	@assert complex64(6) + uint(3) == complex64(9)
	@assert typeof(complex64(6) + uint(3)) == complex64
	@assert complex64(6) + int64(3) == complex64(9)
	@assert typeof(complex64(6) + int64(3)) == complex64
	@assert complex64(6) + uint64(3) == complex64(9)
	@assert typeof(complex64(6) + uint64(3)) == complex64
	@assert complex64(6) + float32(3) == complex64(9)
	@assert typeof(complex64(6) + float32(3)) == complex64
	@assert complex64(6) + float64(3) == complex64(9)
	@assert typeof(complex64(6) + float64(3)) == complex64
	@assert complex64(6) + complex64(3) == complex64(9)
	@assert typeof(complex64(6) + complex64(3)) == complex64
	@assert complex64(6) + complex128(3) == complex128(9)
	@assert typeof(complex64(6) + complex128(3)) == complex128

	@assert complex128(6) + byte(3) == complex128(9)
	@assert typeof(complex128(6) + byte(3)) == complex128
	@assert complex128(6) + int8(3) == complex128(9)
	@assert typeof(complex128(6) + int8(3)) == complex128
	@assert complex128(6) + int16(3) == complex128(9)
	@assert typeof(complex128(6) + int16(3)) == complex128
	@assert complex128(6) + uint16(3) == complex128(9)
	@assert typeof(complex128(6) + uint16(3)) == complex128
	@assert complex128(6) + int32(3) == complex128(9)
	@assert typeof(complex128(6) + int32(3)) == complex128
	@assert complex128(6) + uint32(3) == complex128(9)
	@assert typeof(complex128(6) + uint32(3)) == complex128
	@assert complex128(6) + int(3) == complex128(9)
	@assert typeof(complex128(6) + int(3)) == complex128
	@assert complex128(6) + uint(3) == complex128(9)
	@assert typeof(complex128(6) + uint(3)) == complex128
	@assert complex128(6) + int64(3) == complex128(9)
	@assert typeof(complex128(6) + int64(3)) == complex128
	@assert complex128(6) + uint64(3) == complex128(9)
	@assert typeof(complex128(6) + uint64(3)) == complex128
	@assert complex128(6) + float32(3) == complex128(9)
	@assert typeof(complex128(6) + float32(3)) == complex128
	@assert complex128(6) + float64(3) == complex128(9)
	@assert typeof(complex128(6) + float64(3)) == complex128
	@assert complex128(6) + complex64(3) == complex128(9)
	@assert typeof(complex128(6) + complex64(3)) == complex128
	@assert complex128(6) + complex128(3) == complex128(9)
	@assert typeof(complex128(6) + complex128(3)) == complex128

}

