	@assert typeof(complex128(6) * int16(3)) == complex128
	@assert complex128(6) * uint16(3) == complex128(18)
	@assert typeof(complex128(6) * uint16(3)) == complex128
	@assert complex128(6) * int32(3) == complex128(18)
	@assert typeof(complex128(6) * int32(3)) == complex128
	@assert complex128(6) * uint32(3) == complex128(18)
	@assert typeof(complex128(6) * uint32(3)) == complex128
	@assert complex128(6) * int(3) == complex128(18)
	@assert typeof(complex128(6) * int(3)) == complex128
	@assert complex128(6) * uint(3) == complex128(18)
	@assert typeof(complex128(6) * uint(3)) == complex128
	@assert complex128(6) * int64(3) == complex128(18)
	@assert typeof(complex128(6) * int64(3)) == complex128
	@assert complex128(6) * uint64(3) == complex128(18)
	@assert typeof(complex128(6) * uint64(3)) == complex128
	@assert complex128(6) * float32(3) == complex128(18)
	@assert typeof(complex128(6) * float32(3)) == complex128
	@assert complex128(6) * float64(3) == complex128(18)
	@assert typeof(complex128(6) * float64(3)) == complex128
	@assert complex128(6) * complex64(3) == complex128(18)
	@assert typeof(complex128(6) * complex64(3)) == complex128
	@assert complex128(6) * complex128(3) == complex128(18)
	@assert typeof(complex128(6) * complex128(3)) == complex128

}

@test "datamodel: scalar promotion, division" {
	@type relaxed
	@assert byte(6) / byte(3) == byte(2)
	@assert typeof(byte(6) / byte(3)) == byte
	@assert byte(6) / int8(3) == int8(2)
	@assert typeof(byte(6) / int8(3)) == int8
	@assert byte(6) / int16(3) == int16(2)
	@assert typeof(byte(6) / int16(3)) == int16
	@assert byte(6) / uint16(3) == uint16(2)
	@assert typeof(byte(6) / uint16(3)) == uint16
	@assert byte(6) / int32(3) == int32(2)
	@assert typeof(byte(6) / int32(3)) == int32
	@assert byte(6) / uint32(3) == uint32(2)
	@assert typeof(byte(6) / uint32(3)) == uint32
	@assert byte(6) / int(3) == int(2)
	@assert typeof(byte(6) / int(3)) == int
	@assert byte(6) / uint(3) == uint(2)
	@assert typeof(byte(6) / uint(3)) == uint
	@assert byte(6) / int64(3) == int64(2)
	@assert typeof(byte(6) / int64(3)) == int64
	@assert byte(6) / uint64(3) == uint64(2)
	@assert typeof(byte(6) / uint64(3)) == uint64
	@assert byte(6) / float32(3) == float32(2)
	@assert typeof(byte(6) / float32(3)) == float32
	@assert byte(6) / float64(3) == float64(2)
