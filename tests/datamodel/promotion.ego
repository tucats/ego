	@assert typeof(complex64(6) / complex128(3)) == complex128

	@assert complex128(6) / byte(3) == complex128(2)
	@assert typeof(complex128(6) / byte(3)) == complex128
	@assert complex128(6) / int8(3) == complex128(2)
	@assert typeof(complex128(6) / int8(3)) == complex128
	@assert complex128(6) / int16(3) == complex128(2)
	@assert typeof(complex128(6) / int16(3)) == complex128
	@assert complex128(6) / uint16(3) == complex128(2)
	@assert typeof(complex128(6) / uint16(3)) == complex128
	@assert complex128(6) / int32(3) == complex128(2)
	@assert typeof(complex128(6) / int32(3)) == complex128
	@assert complex128(6) / uint32(3) == complex128(2)
	@assert typeof(complex128(6) / uint32(3)) == complex128
	@assert complex128(6) / int(3) == complex128(2)
	@assert typeof(complex128(6) / int(3)) == complex128
	@assert complex128(6) / uint(3) == complex128(2)
	@assert typeof(complex128(6) / uint(3)) == complex128
	@assert complex128(6) / int64(3) == complex128(2)
	@assert typeof(complex128(6) / int64(3)) == complex128
	@assert complex128(6) / uint64(3) == complex128(2)
	@assert typeof(complex128(6) / uint64(3)) == complex128
	@assert complex128(6) / float32(3) == complex128(2)
	@assert typeof(complex128(6) / float32(3)) == complex128
	@assert complex128(6) / float64(3) == complex128(2)
	@assert typeof(complex128(6) / float64(3)) == complex128
	@assert complex128(6) / complex64(3) == complex128(2)
	@assert typeof(complex128(6) / complex64(3)) == complex128
	@assert complex128(6) / complex128(3) == complex128(2)
	@assert typeof(complex128(6) / complex128(3)) == complex128

}
