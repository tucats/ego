{
    "description": "REST-2: GET /dsns/{name} for a DSN that does not exist is 404. It answered 400 while DELETE on the same path answered 404",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/nosuchdsn-{{DSNUUID}}",
        "headers": {
            "Content-Type": [
                "application/json"
            ],
            "Accept": [
                "*/*"
            ],
            "Authorization": [
                "Bearer {{API_TOKEN}}"
            ]
        }
    },
    "response": {
        "status": 404,
        "headers": {
            "Content-Type": [
                "error+json"
            ]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
