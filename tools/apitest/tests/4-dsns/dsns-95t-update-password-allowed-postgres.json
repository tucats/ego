{
    "description": "PATCH password against a postgres DSN is allowed and the response never echoes it back, even elided as the fixed \"********\" placeholder -- unlike the sqlite suite's dsns-94f rejection",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/pgdsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "password": "newpgpass"
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "password is never echoed back, even elided",
            "query": "password",
            "value": "********"
        }
    ]
}
