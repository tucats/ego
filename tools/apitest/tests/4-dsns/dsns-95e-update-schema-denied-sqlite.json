{
    "description": "PATCH with a schema against a sqlite DSN must be rejected -- schema qualification only means anything for a network provider that has its own catalog/schema namespace",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "schema": "other_schema"
        }
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions Schema field",
            "query": "msg",
            "op": "contains",
            "value": "Schema"
        }
    ]
}
