{
    "description": "REST-1 status codes: a NOT NULL violation is 400, not 409. The old code matched 'constraint' anywhere in the driver message and so called this a conflict, but no change to stored data would make the payload acceptable",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/dsn-{{DSNUUID}}/tables/@sql",
        "headers": {
            "Content-Type": [
                "application/json"
            ],
            "Accept": [
                "*/*"
            ],
            "Authorization": [
                "Bearer {{API_TOKEN}}"
            ]
        },
        "body": [
            "INSERT INTO statuscheck (id, n) VALUES (77, NULL)"
        ]
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": [
                "error+json"
            ]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
