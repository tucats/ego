{
    "description": "PATCH with a syntactically invalid JSON body fails json.Unmarshal in UpdateDSNHandler and is rejected as 400, not 500 -- the body is sent as a raw (non-JSON-object) string here specifically so apitest doesn't \"fix\" it by re-encoding",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": "{ this is not valid json"
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
