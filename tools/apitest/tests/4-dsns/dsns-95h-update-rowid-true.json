{
    "description": "PATCH rowid:true is accepted for a sqlite DSN -- unlike database/host/schema/port/user, row-id has no isLocalDSN gate in UpdateDSNHandler because it applies equally to every provider",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "rowid": true
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "rowid flag set",
            "query": "rowid",
            "value": "true"
        }
    ]
}
