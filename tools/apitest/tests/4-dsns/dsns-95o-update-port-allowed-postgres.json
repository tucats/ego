{
    "description": "PATCH port against a postgres DSN is allowed and takes effect -- unlike the sqlite suite's dsns-95f",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/pgdsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "port": 6543
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "port updated",
            "query": "port",
            "value": "6543"
        }
    ]
}
