{
    "description": "PATCH with a user against a sqlite DSN must be rejected -- a local file provider has no database credential to authenticate. The field context reported is \"User\" (defs.DSNUpdateRequest's JSON tag / the CLI's --username option), not \"Username\"",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "user": "someuser"
        }
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions User field",
            "query": "msg",
            "op": "contains",
            "value": "User"
        }
    ]
}
