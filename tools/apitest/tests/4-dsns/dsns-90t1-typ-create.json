{
    "description": "create table with a full range of value types (SQLite type conversion coverage)",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-{{DSNUUID}}/tables/typeprobe",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept":        ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            { "name": "c_bool", "type": "bool", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } },
            { "name": "c_int", "type": "int", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } },
            { "name": "c_int32", "type": "int32", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } },
            { "name": "c_int16", "type": "int16", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } },
            { "name": "c_byte", "type": "byte", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } },
            { "name": "c_float32", "type": "float32", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } },
            { "name": "c_float64", "type": "float64", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } },
            { "name": "c_string", "type": "string", "size": 0, "nullable": { "specified": false, "value": false }, "unique": { "specified": false, "value": false } }
        ]
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["rowcount+json"],
            "Location": ["/dsns/dsn-{{DSNUUID}}/tables/typeprobe"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
