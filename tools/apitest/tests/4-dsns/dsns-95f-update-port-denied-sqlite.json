{
    "description": "PATCH with a port against a sqlite DSN must be rejected -- a local file provider has nothing listening on a network port",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "port": 5432
        }
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions Port field",
            "query": "msg",
            "op": "contains",
            "value": "Port"
        }
    ]
}
