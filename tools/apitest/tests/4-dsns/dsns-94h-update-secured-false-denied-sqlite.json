{
    "description": "PATCH secured:false against a sqlite DSN must also be rejected -- secured is not-specified-only for a local provider, so neither true nor false is a meaningful explicit value",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "secured": false
        }
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions Secured field",
            "query": "msg",
            "op": "contains",
            "value": "Secured"
        }
    ]
}
