{
    "description": "verify schema introspection reports the portable type name for each column, notably bool (not int/INTEGER)",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-{{DSNUUID}}/tables/typeprobe",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept":        ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["columns+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "column count: 8",
            "query": "count",
            "value": "8"
        },
        {
            "name": "c_bool column type",
            "query": "columns.0.type",
            "value": "bool"
        },
        {
            "name": "c_int16 column type",
            "query": "columns.3.type",
            "value": "int16"
        },
        {
            "name": "c_byte column type",
            "query": "columns.4.type",
            "value": "byte"
        }
    ]
}
