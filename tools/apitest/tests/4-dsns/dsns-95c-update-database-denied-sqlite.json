{
    "description": "PATCH with a database name against a sqlite DSN must be rejected -- a sqlite database is a local file path, not something UpdateDSNHandler lets you retarget through this endpoint for a local provider",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "database": "somewhere-else.db"
        }
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions Database field",
            "query": "msg",
            "op": "contains",
            "value": "Database"
        }
    ]
}
