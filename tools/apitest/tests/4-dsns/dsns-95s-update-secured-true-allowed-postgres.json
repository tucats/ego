{
    "description": "PATCH secured:true against a postgres DSN is allowed -- unlike the sqlite suite's dsns-94g/95's rejection, a network provider can genuinely use TLS. Mirrors tests-pg/4-dsns/dsns-94g against a real server; this metadata-only version proves the accept path doesn't require live connectivity",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/pgdsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "secured": true
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "secured flag set",
            "query": "secured",
            "value": "true"
        }
    ]
}
