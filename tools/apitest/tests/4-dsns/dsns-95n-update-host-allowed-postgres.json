{
    "description": "PATCH host against a postgres DSN is allowed and takes effect -- unlike the sqlite suite's dsns-95d, isLocalDSN's rejection block never triggers for a network provider",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/pgdsn2-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "host": "pg2.example.internal"
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "host updated",
            "query": "host",
            "value": "pg2.example.internal"
        }
    ]
}
