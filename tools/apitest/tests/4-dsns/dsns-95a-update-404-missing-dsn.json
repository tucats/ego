{
    "description": "REST-2: PATCH /dsns/{name} for a DSN that does not exist is 404, same classifier as GET/DELETE on the same path -- there was no dedicated regression test for the PATCH case before this suite",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/nosuchdsn-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "secured": false
        }
    },
    "response": {
        "status": 404,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
