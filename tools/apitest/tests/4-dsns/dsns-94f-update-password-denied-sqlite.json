{
    "description": "PATCH with a password against a sqlite DSN must be rejected -- a sqlite database is a local file with no network credential at all. Regression check for the field context: this must name \"Password\", not the copy-pasted \"secured flag\" wording that a bug in UpdateDSNHandler emitted before the ErrDSNSecuredNotApplicable/ErrDSNNotApplicable mix-up was fixed",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "password": "irrelevant"
        }
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions Password field",
            "query": "msg",
            "op": "contains",
            "value": "Password"
        }
    ]
}
