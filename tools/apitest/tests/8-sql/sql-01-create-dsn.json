{
    "description": "create a restricted dsn used to exercise @sql permission checks -- table_perms enforcement (Authorized()) is gated on Restricted, not Secured (DATA-SECURITY.md §3.1); Secured means TLS only and is irrelevant to a local sqlite file",
    "request": {
        "method": "POST",
        "endpoint": "/dsns",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "dsn-{{SQLTESTID}}",
            "provider": "sqlite",
            "database": "{{ROOT}}/db-{{SQLTESTID}}.db",
            "rowid": true,
            "restricted": true
        }
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["dsn+json"],
            "Location": ["/dsns/dsn-{{SQLTESTID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
