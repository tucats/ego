{
    "description": "clean up the @transaction test user. Its dsns_auth and table_perms grants are removed when dsn-{{SQLTESTID}} itself is deleted at sql-91 (DeleteDSNHandler cascades dsns_auth; DeletePermissionsByDSN cascades table_perms).",
    "request": {
        "method": "DELETE",
        "endpoint": "/admin/users/sqtx{{SQLTESTID}}",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "user name",
            "query": "name",
            "value": "sqtx{{SQLTESTID}}"
        }
    ]
}
