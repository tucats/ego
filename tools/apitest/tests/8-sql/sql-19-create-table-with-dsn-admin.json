{
    "description": "with ego.dsn.admin granted, CREATE TABLE now succeeds for the non-admin user",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/dsn-{{SQLTESTID}}/tables/@sql",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{SQL_TOKEN}}"]
        },
        "body": [
            "CREATE TABLE t2{{SQLTESTID}} (id INTEGER NOT NULL, name TEXT NOT NULL)"
        ]
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
