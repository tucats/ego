{
    "description": "as admin, create the scratch table used by the permission tests below -- admin bypasses table_perms and dsn.admin checks entirely, so this works even though no grants exist yet",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/dsn-{{SQLTESTID}}/tables/@sql",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            "CREATE TABLE t{{SQLTESTID}} (id INTEGER NOT NULL, name TEXT NOT NULL)"
        ]
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
