{
    "description": "Create user with a name that already exists reports 409, not a silent overwrite",
    "request": {
        "method": "POST",
        "endpoint": "/admin/users/",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Content-Type": ["application/vmd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "u{{USERUUID}}",
            "password": "should-not-be-applied",
            "permissions": [
               "ego.logon"
            ]
         }
    },
    "response": {
        "status": 409,
        "headers": {
            "Content-Type": ["application/vnd.ego.error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error text",
            "query": "msg",
            "op": "contains",
            "value": "u{{USERUUID}}"
        }
    ]
}
