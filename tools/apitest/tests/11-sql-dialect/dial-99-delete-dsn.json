{
    "description": "clean up the dialect-rewrite test dsn and its backing sqlite3 file",
    "request": {
        "method": "DELETE",
        "endpoint": "/dsns/dsn-{{DLID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ],
    "tasks": [
        {
            "command": "DELETE",
            "parameters": ["{{ROOT}}/db-{{DLID}}.db"]
        },
        {
            "command": "DELETE",
            "parameters": ["{{ROOT}}/db-{{DLID}}.db-shm"]
        },
        {
            "command": "DELETE",
            "parameters": ["{{ROOT}}/db-{{DLID}}.db-wal"]
        }
    ]
}
