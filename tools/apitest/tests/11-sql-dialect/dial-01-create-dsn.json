{
    "description": "create a sqlite dsn used to verify that PostgreSQL-authored @sql DDL/DML (SERIAL/BIGSERIAL/SMALLSERIAL, GENERATED ... AS IDENTITY, INSERT ... ON CONFLICT) is rewritten to sqlite3's own idioms -- see sqlparse.Sqlparse.Rewrite",
    "request": {
        "method": "POST",
        "endpoint": "/dsns",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "dsn-{{DLID}}",
            "provider": "sqlite",
            "database": "{{ROOT}}/db-{{DLID}}.db",
            "rowid": true
        }
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["dsn+json"],
            "Location": ["/dsns/dsn-{{DLID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
