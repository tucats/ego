{
    "description": "SERIAL on a column that is part of a composite (multi-column) PRIMARY KEY cannot be translated toward sqlite3, since AUTOINCREMENT is only legal on a single-column INTEGER PRIMARY KEY",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/dsn-{{DLID}}/tables/@sql",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            "CREATE TABLE tG{{DLID}} (id SERIAL, other TEXT, PRIMARY KEY (id, other))"
        ]
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message explains the dialect translation failure",
            "query": "msg",
            "op": "contains",
            "value": "cannot translate"
        }
    ]
}
