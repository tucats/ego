{
    "description": "create a test user with ego.logon and ego.sql (needed to reach the @sql route at all) but deliberately NO identity-level ego.dsn.admin, so the DDL test below isolates the DSN-specific admin record as the sole reason it succeeds",
    "request": {
        "method": "POST",
        "endpoint": "/admin/users/",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Content-Type": ["application/vmd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "sqlspecificadmintest",
            "password": "zork",
            "permissions": [
                "ego.logon",
                "ego.sql"
            ]
        }
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"],
            "Location": ["/admin/users/sqlspecificadmintest"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "user name",
            "query": "name",
            "value": "sqlspecificadmintest"
        }
    ]
}
