{
    "description": "as admin, create the scratch table used by the permission tests below -- admin bypasses AuthDSN and table_perms checks entirely",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-{{PERMTESTID}}/tables/t{{PERMTESTID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            {
                "name": "id",
                "type": "int",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            },
            {
                "name": "name",
                "type": "string",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            }
        ]
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["rowcount+json"],
            "Location": ["/dsns/dsn-{{PERMTESTID}}/tables/t{{PERMTESTID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
