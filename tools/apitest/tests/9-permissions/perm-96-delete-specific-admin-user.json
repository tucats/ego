{
    "description": "clean up the DSN-specific-admin test user (its dsn, dsn-sa{{PERMTESTID}}, was already deleted by perm-57 as part of that regression test)",
    "request": {
        "method": "DELETE",
        "endpoint": "/admin/users/specificadmintest",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "user name",
            "query": "name",
            "value": "specificadmintest"
        }
    ]
}
