{
    "description": "REGRESSION: with ego.server.admin (not ego.root), listing server users is now allowed",
    "request": {
        "method": "GET",
        "endpoint": "/admin/users",
        "headers": {
            "Accept": ["application/vnd.ego.users+json"],
            "Authorization": ["Bearer {{SVCADMIN_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.users+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "test user is present in list",
            "query": "items.*.name",
            "value": "svc{{PERMTESTID}}"
        }
    ]
}
