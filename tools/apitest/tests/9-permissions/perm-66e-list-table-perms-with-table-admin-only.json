{
    "description": "REGRESSION for DATA-SECURITY-2.md finding #4: tabadmintest, still authorized only by its ego.table.admin grant on t{{PERMTESTID}}, lists every user's permissions on that table (ReadTablePermissions). Same gap as perm-66d, different route.",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-{{PERMTESTID}}/tables/t{{PERMTESTID}}/@permissions",
        "headers": {
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{TABADMIN_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "sees its own admin grant in the listing",
            "query": "permissions.*.user",
            "value": "tabadmintest"
        }
    ]
}
