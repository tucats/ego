{
    "description": "non-admin user has the identity-wide ego.table.read gate but no dsns_auth record at all -- cannot open the restricted DSN for an abstract read, denied at the AuthDSN gate before table_perms is ever consulted",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-{{PERMTESTID}}/tables/t{{PERMTESTID}}/rows",
        "parameters": {
            "abstract": "true"
        },
        "headers": {
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{PERM_TOKEN}}"]
        }
    },
    "response": {
        "status": 403,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions missing privilege",
            "query": "msg",
            "op": "contains",
            "value": "privilege"
        }
    ]
}
