{
    "description": "create a test user dedicated to DATA-SECURITY-2.md finding #4: deliberately no identity-level ego.dsn.* permission and no dsns_auth record of any kind -- the tests below (perm-66a..perm-66i) isolate a table-specific ego.table.admin grant, and only that grant, as the sole reason access to the table permission-management routes succeeds.",
    "request": {
        "method": "POST",
        "endpoint": "/admin/users/",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Content-Type": ["application/vmd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "tabadmintest",
            "password": "zork",
            "permissions": [
                "ego.logon"
            ]
        }
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"],
            "Location": ["/admin/users/tabadmintest"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "user name",
            "query": "name",
            "value": "tabadmintest"
        }
    ]
}
