{
    "description": "create a second non-admin test user, dedicated to the identity-level DSN permission tests, with only ego.logon",
    "request": {
        "method": "POST",
        "endpoint": "/admin/users/",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Content-Type": ["application/vmd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "idn{{PERMTESTID}}",
            "password": "zork",
            "permissions": [
                "ego.logon"
            ]
        }
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"],
            "Location": ["/admin/users/idn{{PERMTESTID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "user name",
            "query": "name",
            "value": "idn{{PERMTESTID}}"
        }
    ]
}
