{
    "description": "REGRESSION for DATA-SECURITY.md §3.5: grant identity-level ego.dsn.write, the second of the two permissions that used to be missing from defs.AllPermissions.",
    "request": {
        "method": "PATCH",
        "endpoint": "/admin/users/idn{{PERMTESTID}}",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Content-Type": ["application/vmd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "idn{{PERMTESTID}}",
            "permissions": [
                "+ego.dsn.write"
            ]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"]
        }
    },
    "tests": [
        {
            "name": "identity dsn.write granted",
            "query": "permissions.*",
            "value": "ego.dsn.write"
        }
    ]
}
