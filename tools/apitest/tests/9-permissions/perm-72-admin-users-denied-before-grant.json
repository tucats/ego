{
    "description": "baseline: with only ego.logon, listing server users must be denied",
    "request": {
        "method": "GET",
        "endpoint": "/admin/users",
        "headers": {
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{SVCADMIN_TOKEN}}"]
        }
    },
    "response": {
        "status": 403,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
