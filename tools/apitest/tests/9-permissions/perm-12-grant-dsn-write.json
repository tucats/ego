{
    "description": "grant the test user DSN-specific ego.dsn.write on the restricted DSN, in addition to the read it already holds",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/@permissions",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "dsn": "dsn-{{PERMTESTID}}",
            "user": "pmu{{PERMTESTID}}",
            "actions": ["+ego.dsn.write"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "one item granted",
            "query": "count",
            "value": "1"
        }
    ]
}
