{
    "description": "admin grants specificadmintest a DSN-specific dsns_auth ego.dsn.admin record for dsn-sa{{PERMTESTID}} only -- not an identity-level permission",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/@permissions",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "dsn": "dsn-sa{{PERMTESTID}}",
            "user": "specificadmintest",
            "actions": ["+ego.dsn.admin"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "one item granted",
            "query": "count",
            "value": "1"
        }
    ]
}
