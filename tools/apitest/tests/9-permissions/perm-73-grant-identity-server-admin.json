{
    "description": "grant the ego.server.admin identity permission to the test user",
    "request": {
        "method": "PATCH",
        "endpoint": "/admin/users/svc{{PERMTESTID}}",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Content-Type": ["application/vmd.ego.user+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "svc{{PERMTESTID}}",
            "permissions": [
                "+ego.server.admin"
            ]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "user name",
            "query": "name",
            "value": "svc{{PERMTESTID}}"
        },
        {
            "name": "server admin permission granted",
            "query": "permissions.*",
            "value": "ego.server.admin"
        }
    ]
}
