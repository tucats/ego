{
    "description": "REGRESSION for DATA-SECURITY.md §3.2: user now has DSN-level read access (dsns_auth) but no table_perms grant on this table. Before the fix, ReadAbstractRows's inverted check (missing '!' before Authorized()) let an UNgranted caller like this one through; it must now be denied.",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-{{PERMTESTID}}/tables/t{{PERMTESTID}}/rows",
        "parameters": {
            "abstract": "true"
        },
        "headers": {
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{PERM_TOKEN}}"]
        }
    },
    "response": {
        "status": 403,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
