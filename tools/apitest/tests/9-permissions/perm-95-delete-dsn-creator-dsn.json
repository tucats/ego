{
    "description": "clean up the DSN-creator test dsn -- this also removes its table_perms entries (DeletePermissionsByDSN) and dsns_auth entries, including the self-grant this test group just verified (DeleteDSN)",
    "request": {
        "method": "DELETE",
        "endpoint": "/dsns/dsn-cr{{PERMTESTID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ],
    "tasks": [
        {
            "command": "DELETE",
            "parameters": ["{{ROOT}}/db-cr{{PERMTESTID}}.db"]
        },
        {
            "command": "DELETE",
            "parameters": ["{{ROOT}}/db-cr{{PERMTESTID}}.db-shm"]
        },
        {
            "command": "DELETE",
            "parameters": ["{{ROOT}}/db-cr{{PERMTESTID}}.db-wal"]
        }
    ]
}
