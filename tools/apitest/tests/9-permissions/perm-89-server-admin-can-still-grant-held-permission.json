{
    "description": "Sanity check that the new rule is scoped correctly: svc{{PERMTESTID}} still holds ego.logon (granted at creation, perm-70) and ego.server.admin (granted at perm-73), so re-asserting '+ego.logon' on itself -- a permission it already holds -- must still succeed. This is the ordinary, non-escalating case the fix must not break.",
    "request": {
        "method": "PATCH",
        "endpoint": "/admin/users/svc{{PERMTESTID}}",
        "headers": {
            "Accept": ["application/vnd.ego.user+json"],
            "Content-Type": ["application/vmd.ego.user+json"],
            "Authorization": ["Bearer {{SVCADMIN_TOKEN}}"]
        },
        "body": {
            "name": "svc{{PERMTESTID}}",
            "permissions": [
                "+ego.logon"
            ]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.user+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "user name",
            "query": "name",
            "value": "svc{{PERMTESTID}}"
        },
        {
            "name": "ego.logon still present",
            "query": "permissions.*",
            "value": "ego.logon"
        },
        {
            "name": "ego.server.admin still present",
            "query": "permissions.*",
            "value": "ego.server.admin"
        }
    ]
}
