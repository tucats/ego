{
    "description": "REGRESSION for DATA-SECURITY.md §3.2: user has DSN-level read but not write. InsertAbstractRows must open the DSN with dsns.DSNWriteAction and be denied here. Before the fix it requested DSNNoAccess (0), which AuthDSN's bitmask test can never satisfy -- so this exact request was ALWAYS denied regardless of any grant, masking whether write authorization was being checked correctly at all.",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-{{PERMTESTID}}/tables/t{{PERMTESTID}}/rows",
        "parameters": {
            "abstract": "true"
        },
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{PERM_TOKEN}}"]
        },
        "body": {
            "id": 1,
            "name": "should-not-insert"
        }
    },
    "response": {
        "status": 403,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions missing privilege",
            "query": "msg",
            "op": "contains",
            "value": "privilege"
        }
    ]
}
