{
    "description": "create the first restricted dsn used to exercise table_perms scoping: multiple tables in one DSN with differing grants, and the same table name colliding with a second DSN (scope-02)",
    "request": {
        "method": "POST",
        "endpoint": "/dsns",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "name": "dsn-ts{{TSID}}",
            "provider": "sqlite",
            "database": "{{ROOT}}/db-ts{{TSID}}.db",
            "restricted": true
        }
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["dsn+json"],
            "Location": ["/dsns/dsn-ts{{TSID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "restricted flag echoed",
            "query": "restricted",
            "value": "true"
        }
    ]
}
