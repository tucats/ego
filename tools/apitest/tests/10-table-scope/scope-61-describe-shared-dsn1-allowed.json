{
    "description": "REGRESSION for describe.go's db.Restricted gating: the same describe request against dsn-ts{{TSID}}'s copy of sh{{TSID}}, which DOES have a table_perms read grant (scope-50), must succeed",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-ts{{TSID}}/tables/sh{{TSID}}",
        "headers": {
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{TS_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["columns+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "column count: 2",
            "query": "count",
            "value": "2"
        }
    ]
}
