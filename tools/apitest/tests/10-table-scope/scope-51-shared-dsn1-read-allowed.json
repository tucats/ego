{
    "description": "sanity check: dsn-ts{{TSID}}'s copy of sh{{TSID}} is readable now that it has its own table_perms grant",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-ts{{TSID}}/tables/sh{{TSID}}/rows",
        "headers": {
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{TS_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rows+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "no rows yet",
            "query": "count",
            "value": "0"
        }
    ]
}
