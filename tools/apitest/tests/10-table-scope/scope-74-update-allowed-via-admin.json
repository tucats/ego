{
    "description": "REGRESSION for the table.admin-implies-update fix: same user, still no explicit ego.table.update grant on tblC{{TSID}} -- only ego.table.admin (scope-71). A non-abstract PATCH (UpdateRows) must succeed via Authorized()'s TableUpdatePermission case now accepting perm.Admin.",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/dsn-ts{{TSID}}/tables/tblC{{TSID}}/rows",
        "parameters": {
            "filter": "EQ(id,1)"
        },
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{TS_TOKEN}}"]
        },
        "body": {
            "name": "admin-implied-update"
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "one row updated",
            "query": "count",
            "value": "1"
        }
    ]
}
