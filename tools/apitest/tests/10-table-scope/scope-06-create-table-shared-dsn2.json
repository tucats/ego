{
    "description": "as admin, create a table with the SAME name sh{{TSID}} in dsn-ts2{{TSID}} -- deliberately colliding with dsn-ts{{TSID}}'s table of the same name (scope-05). This is the setup for the regression fdf0872a fixed: table_perms lookups keyed on table name alone (rather than dsn+table) would let a grant on one DSN's copy authorize the other DSN's identically-named table",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-ts2{{TSID}}/tables/sh{{TSID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            {
                "name": "id",
                "type": "int",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            },
            {
                "name": "name",
                "type": "string",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            }
        ]
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["rowcount+json"],
            "Location": ["/dsns/dsn-ts2{{TSID}}/tables/sh{{TSID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
