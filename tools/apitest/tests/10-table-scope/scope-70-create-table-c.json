{
    "description": "as admin, create a third scratch table in dsn-ts{{TSID}} -- used to verify that ego.table.admin alone (with no explicit read/write/update/delete grant) implies all of them, without any prior grant on this table muddying the result",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-ts{{TSID}}/tables/tblC{{TSID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            {
                "name": "id",
                "type": "int",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            },
            {
                "name": "name",
                "type": "string",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            }
        ]
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["rowcount+json"],
            "Location": ["/dsns/dsn-ts{{TSID}}/tables/tblC{{TSID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
