{
    "description": "grant the test user DSN-specific ego.dsn.read and ego.dsn.write on dsn-ts{{TSID}} (a dsns_auth record, not an identity permission) so it can open the DSN at all -- table_perms grants (or their absence) are what the tests below actually exercise",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/@permissions",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "dsn": "dsn-ts{{TSID}}",
            "user": "tsu{{TSID}}",
            "actions": ["+ego.dsn.read", "+ego.dsn.write"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "one item granted",
            "query": "count",
            "value": "1"
        }
    ]
}
