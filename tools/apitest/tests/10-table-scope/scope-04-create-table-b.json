{
    "description": "as admin, create scratch table B in the SAME dsn-ts{{TSID}} as table A -- used to prove a table_perms grant on table A does not leak to table B in the same, already-DSN-accessible, restricted DSN (scope-40..44)",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-ts{{TSID}}/tables/tblB{{TSID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            {
                "name": "id",
                "type": "int",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            },
            {
                "name": "name",
                "type": "string",
                "size": 0,
                "nullable": { "specified": false, "value": false },
                "unique": { "specified": false, "value": false }
            }
        ]
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["rowcount+json"],
            "Location": ["/dsns/dsn-ts{{TSID}}/tables/tblB{{TSID}}"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
