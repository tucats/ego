{
    "description": "add table_perms ego.table.update on tblA{{TSID}}",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-ts{{TSID}}/tables/tblA{{TSID}}/permissions",
        "parameters": {
            "user": "tsu{{TSID}}"
        },
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            "ego.table.update"
        ]
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/json"]
        }
    },
    "tests": [
        {
            "name": "update permission granted",
            "query": "permissions.*",
            "value": "ego.table.update"
        }
    ]
}
