{
    "description": "REGRESSION for the table.admin-implies-delete fix: same user, still no explicit ego.table.delete grant on tblC{{TSID}} -- only ego.table.admin (scope-71). A non-abstract DELETE (DeleteRows) must succeed via Authorized()'s TableDeletePermission case now accepting perm.Admin.",
    "request": {
        "method": "DELETE",
        "endpoint": "/dsns/dsn-ts{{TSID}}/tables/tblC{{TSID}}/rows",
        "parameters": {
            "filter": "EQ(id,1)"
        },
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{TS_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "one row deleted",
            "query": "count",
            "value": "1"
        }
    ]
}
