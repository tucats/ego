{
    "description": "verify the upsert changed only the k2 row, in place, and left the other rows alone",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-{{UKID}}/tables/people/rows",
        "parameters": {
            "sort": "id"
        },
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rows+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        { "name": "rows count", "query": "count", "value": "3" },
        { "name": "row 0 id", "query": "rows.0.id", "value": "k1" },
        { "name": "row 0 name", "query": "rows.0.name", "value": "Ann" },
        { "name": "row 0 age", "query": "rows.0.age", "value": "10" },
        { "name": "row 1 id", "query": "rows.1.id", "value": "k2" },
        { "name": "row 1 name", "query": "rows.1.name", "value": "Bobby" },
        { "name": "row 1 age", "query": "rows.1.age", "value": "21" },
        { "name": "row 1 row id unchanged", "query": "rows.1._row_id_", "value": "{{K2_ROW_ID}}" },
        { "name": "row 2 id", "query": "rows.2.id", "value": "k3" },
        { "name": "row 2 name", "query": "rows.2.name", "value": "Cat" },
        { "name": "row 2 age", "query": "rows.2.age", "value": "30" }
    ]
}
