{
    "description": "create a table whose \"id\" column is a unique user key, alongside the dsn-supplied _row_id_",
    "request": {
        "method": "PUT",
        "endpoint": "/dsns/dsn-{{UKID}}/tables/people",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            {
                "name": "id",
                "type": "string",
                "nullable": { "specified": true, "value": false },
                "unique": { "specified": true, "value": true }
            },
            {
                "name": "name",
                "type": "string"
            },
            {
                "name": "age",
                "type": "int"
            }
        ]
    },
    "response": {
        "status": 201,
        "headers": {
            "Content-Type": ["rowcount+json"],
            "Location": ["/dsns/dsn-{{UKID}}/tables/people"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
