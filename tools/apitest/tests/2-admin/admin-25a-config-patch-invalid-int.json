{
    "description": "PATCH /admin/config rejects a non-numeric value for an int setting",
    "request": {
        "method": "PATCH",
        "endpoint": "/admin/config",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "ego.server.max.item.limit": "not-a-number"
        }
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "invalid data error message",
            "query": "msg",
            "op": "contains",
            "value": "invalid data"
        },
        {
            "name": "invalid data error names the key",
            "query": "msg",
            "op": "contains",
            "value": "ego.server.max.item.limit"
        }
    ]
}
