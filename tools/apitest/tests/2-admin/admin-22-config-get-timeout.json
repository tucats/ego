{
    "description": "Fetch the current ego.runtime.rest.timeout value before patching it, so it can be restored afterward",
    "request": {
        "method": "POST",
        "endpoint": "/admin/config",
        "headers": {
            "Content-Type": ["application/vnd.ego.config.list+json"],
            "Accept": ["application/vnd.ego.config+json"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            "ego.runtime.rest.timeout"
        ]
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.config+json"]
        },
        "save": {
            "REST_TIMEOUT_ORIG": "items.ego\\.runtime\\.rest\\.timeout.value"
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "ego.runtime.rest.timeout not readonly",
            "query": "items.ego\\.runtime\\.rest\\.timeout.readonly",
            "op": "not-exists"
        }
    ]
}
