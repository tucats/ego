{
    "description": "a client_credentials token has no subject and is rejected by /oauth2/userinfo",
    "request": {
        "method": "GET",
        "endpoint": "{{AS_URL}}/oauth2/userinfo",
        "headers": {
            "Accept": ["application/json"],
            "Authorization": ["Bearer {{ADMIN_JWT}}"]
        }
    },
    "response": {
        "status": 403,
        "headers": {
            "Content-Type": ["error+json"]
        }
    }
}
