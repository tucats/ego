{
    "description": "a revoked token is rejected by /oauth2/userinfo on the same AS instance",
    "request": {
        "method": "GET",
        "endpoint": "{{AS_URL}}/oauth2/userinfo",
        "headers": {
            "Accept": ["application/json"],
            "Authorization": ["Bearer {{USER_JWT}}"]
        }
    },
    "response": {
        "status": 401,
        "headers": {
            "Content-Type": ["error+json"],
            "Www-Authenticate": ["invalid_token"]
        }
    }
}
