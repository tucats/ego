{
    "description": "POST /oauth2/revoke always returns 200 (RFC 7009 2.2)",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/revoke",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["*/*"]
        },
        "body": "token={{USER_JWT}}&client_id={{OAUTH_CLIENT_ID}}&client_secret={{OAUTH_CLIENT_SECRET}}"
    },
    "response": {
        "status": 200
    }
}
