{
    "description": "client_credentials grant with wrong secret is rejected (RFC 6749 5.2 invalid_client)",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/token",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["application/json"]
        },
        "body": "grant_type=client_credentials&client_id={{OAUTH_CLIENT_ID}}&client_secret=totally-wrong-secret&scope=openid"
    },
    "response": {
        "status": 401,
        "headers": {
            "Content-Type": ["application/json"],
            "Www-Authenticate": ["Basic"]
        }
    },
    "tests": [
        { "name": "error code", "query": "error", "value": "invalid_client" }
    ]
}
