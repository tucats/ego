{
    "description": "an unregistered client_id is rejected (RFC 6749 5.2 invalid_client)",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/token",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["application/json"]
        },
        "body": "grant_type=client_credentials&client_id=no-such-client&client_secret=whatever&scope=openid"
    },
    "response": {
        "status": 401,
        "headers": {
            "Content-Type": ["application/json"]
        }
    },
    "tests": [
        { "name": "error code", "query": "error", "value": "invalid_client" }
    ]
}
