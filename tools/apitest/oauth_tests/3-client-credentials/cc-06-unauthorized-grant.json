{
    "description": "client not registered for client_credentials is rejected (RFC 6749 5.2 unauthorized_client)",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/token",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["application/json"]
        },
        "body": "grant_type=client_credentials&client_id={{OAUTH_AUTHCODE_ONLY_CLIENT_ID}}&client_secret={{OAUTH_AUTHCODE_ONLY_CLIENT_SECRET}}&scope=openid"
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["application/json"]
        }
    },
    "tests": [
        { "name": "error code", "query": "error", "value": "unauthorized_client" }
    ]
}
