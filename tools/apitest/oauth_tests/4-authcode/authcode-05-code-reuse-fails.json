{
    "description": "an authorization code is single-use; replaying it is rejected (RFC 6749 4.1.2)",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/token",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["application/json"]
        },
        "body": "grant_type=authorization_code&code={{AUTH_CODE}}&redirect_uri={{OAUTH_REDIRECT_URI}}&client_id={{OAUTH_CLIENT_ID}}&client_secret={{OAUTH_CLIENT_SECRET}}&code_verifier={{PKCE_VERIFIER}}"
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["application/json"]
        }
    },
    "tests": [
        { "name": "error code", "query": "error", "value": "invalid_grant" }
    ]
}
