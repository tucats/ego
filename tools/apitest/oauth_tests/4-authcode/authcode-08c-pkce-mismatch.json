{
    "description": "token exchange with the wrong code_verifier is rejected (RFC 7636 4.6 PKCE verification)",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/token",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["application/json"]
        },
        "body": "grant_type=authorization_code&code={{AUTH_CODE_2}}&redirect_uri={{OAUTH_REDIRECT_URI}}&client_id={{OAUTH_CLIENT_ID}}&client_secret={{OAUTH_CLIENT_SECRET}}&code_verifier=this-is-definitely-the-wrong-verifier-0000000000000000000000"
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["application/json"]
        }
    },
    "tests": [
        { "name": "error code", "query": "error", "value": "invalid_grant" }
    ]
}
