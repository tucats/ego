{
    "description": "the original refresh token is consumed by rotation and can no longer be used",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/token",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["application/json"]
        },
        "body": "grant_type=refresh_token&refresh_token={{USER_REFRESH_TOKEN}}&client_id={{OAUTH_CLIENT_ID}}&client_secret={{OAUTH_CLIENT_SECRET}}"
    },
    "response": {
        "status": 400,
        "headers": {
            "Content-Type": ["application/json"]
        }
    },
    "tests": [
        { "name": "error code", "query": "error", "value": "invalid_grant" }
    ]
}
