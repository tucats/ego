{
    "description": "GET /oauth2/authorize serves the login form and issues a CSRF cookie",
    "request": {
        "method": "GET",
        "endpoint": "{{AS_URL}}/oauth2/authorize",
        "parameters": {
            "response_type": "code",
            "client_id": "{{OAUTH_CLIENT_ID}}",
            "redirect_uri": "{{OAUTH_REDIRECT_URI}}",
            "scope": "openid%20ego:admin",
            "state": "apitest-state-1",
            "code_challenge": "{{PKCE_CHALLENGE}}",
            "code_challenge_method": "S256"
        },
        "headers": {
            "Accept": ["text/html"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["text/html"],
            "Set-Cookie": ["ego_oauth_csrf"]
        },
        "save": {
            "CSRF_COOKIE": "header:Set-Cookie:cookie",
            "CSRF_TOKEN_VALUE": "header:Set-Cookie:value"
        }
    }
}
