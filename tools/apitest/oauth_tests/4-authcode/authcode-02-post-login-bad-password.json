{
    "description": "POST /oauth2/authorize with wrong password re-renders the form with a fresh CSRF token instead of failing permanently (OAUTH-H4)",
    "request": {
        "method": "POST",
        "endpoint": "{{AS_URL}}/oauth2/authorize",
        "headers": {
            "Content-Type": ["application/x-www-form-urlencoded"],
            "Accept": ["text/html"],
            "Cookie": ["{{CSRF_COOKIE}}"]
        },
        "body": "client_id={{OAUTH_CLIENT_ID}}&redirect_uri={{OAUTH_REDIRECT_URI}}&scope=openid%20ego:admin&state=apitest-state-1&code_challenge={{PKCE_CHALLENGE}}&code_challenge_method=S256&username={{USER}}&password=totally-wrong-password&csrf_token={{CSRF_TOKEN_VALUE}}"
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["text/html"],
            "Set-Cookie": ["ego_oauth_csrf"]
        }
    }
}
