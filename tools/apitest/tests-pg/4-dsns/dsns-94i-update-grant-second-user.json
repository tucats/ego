{
    "description": "grant a second, throwaway user read access on the restricted DSN, so the cascade-delete test below can prove every user's permission record is removed, not just the caller's own",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/@permissions",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "dsn": "udsn-{{DSNUUID}}",
            "user": "udx{{DSNUUID}}",
            "actions": ["+ego.dsn.read"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "one item granted",
            "query": "count",
            "value": "1"
        }
    ]
}
