{
    "description": "a numeric UTC offset is honored and normalized to UTC, whatever timezone the server runs in (TIME-2)",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/dsn-{{DSNUUID}}/tables/events{{DTUUID}}/rows",
        "parameters": {
            "filter": "EQ(title,\"offset-west\")"
        },
        "headers": {
            "Content-Type": ["application/json"],
            "Accept":        ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rows+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "one row returned",
            "query": "count",
            "value": "1"
        },
        {
            "name": "12:00 at -05:00 is stored as 17:00 UTC",
            "query": "rows.0.event_time",
            "value": "2024-06-15T17:00:00Z"
        }
    ]
}
