{
    "description": "with a per-DSN ego.dsn.admin grant (but no identity-level ego.dsn.admin permission), the non-admin user can now read the restricted DSN",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/gdsn-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{GETDSN_TOKEN}}"]
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "dsn name",
            "query": "name",
            "value": "gdsn-{{DSNUUID}}"
        }
    ]
}
