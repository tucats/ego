{
    "description": "non-admin user has neither identity-level ego.dsn.admin nor a per-DSN dsns_auth admin record for this restricted DSN yet, so GET /dsns/{name} must be denied",
    "request": {
        "method": "GET",
        "endpoint": "/dsns/gdsn-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{GETDSN_TOKEN}}"]
        }
    },
    "response": {
        "status": 403,
        "headers": {
            "Content-Type": ["error+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "error message mentions missing privilege",
            "query": "msg",
            "op": "contains",
            "value": "privilege"
        }
    ]
}
