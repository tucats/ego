{
    "description": "REST-1 status codes: dropping a table that does not exist is 404",
    "request": {
        "method": "DELETE",
        "endpoint": "/dsns/dsn-{{DSNUUID}}/tables/nosuchtable",
        "headers": {
            "Content-Type": [
                "application/json"
            ],
            "Accept": [
                "*/*"
            ],
            "Authorization": [
                "Bearer {{API_TOKEN}}"
            ]
        }
    },
    "response": {
        "status": 404,
        "headers": {
            "Content-Type": [
                "error+json"
            ]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
