{
    "description": "PATCH secured:false toggles the postgres DSN back off, following dsns-94g's secured:true -- a genuine state change here (unlike the sqlite suite's dsns-94h, where secured was already false and the PATCH was a no-op), since postgres actually honors the flag both ways",
    "request": {
        "method": "PATCH",
        "endpoint": "/dsns/udsn-{{DSNUUID}}",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": {
            "secured": false
        }
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["application/vnd.ego.dsn+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        },
        {
            "name": "secured flag toggled back off",
            "query": "secured",
            "value": "false"
        }
    ]
}
