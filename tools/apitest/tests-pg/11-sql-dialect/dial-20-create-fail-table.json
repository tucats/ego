{
    "description": "create the table used to verify INSERT OR FAIL and INSERT OR ROLLBACK -- neither has a PostgreSQL equivalent, so Rewrite must reject both rather than silently downgrading them",
    "request": {
        "method": "POST",
        "endpoint": "/dsns/dsn-{{DLID}}/tables/@sql",
        "headers": {
            "Content-Type": ["application/json"],
            "Accept": ["*/*"],
            "Authorization": ["Bearer {{API_TOKEN}}"]
        },
        "body": [
            "CREATE TABLE tF{{DLID}} (id INTEGER PRIMARY KEY, name TEXT)"
        ]
    },
    "response": {
        "status": 200,
        "headers": {
            "Content-Type": ["rowcount+json"]
        }
    },
    "tests": [
        {
            "name": "api version",
            "query": "server.api",
            "value": "1"
        },
        {
            "name": "server id",
            "query": "server.id",
            "value": "{{SERVER_ID}}"
        }
    ]
}
